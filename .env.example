# Base URL of the RideForge backend API. Optional — when unset, the app falls back to
# the live Railway production URL (see src/api/config.ts). Set this to point the app at
# a local or staging backend during development.
#
# NOTE: EXPO_PUBLIC_* values are inlined at build time. After changing this, restart the
# dev server with a cleared cache:  npx expo start --clear
EXPO_PUBLIC_API_URL=https://rideforge-api-production.up.railway.app

# Supabase project URL and anon (publishable) key, from the project's API settings.
# Required — unlike EXPO_PUBLIC_API_URL these have no fallback: src/lib/supabase.ts throws at
# startup when either is missing, because a client pointed at nothing fails far less visibly.
#
# The project must have asymmetric JWT signing keys enabled (RS256/ES256) — the backend verifies
# tokens against {EXPO_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json, which serves an empty
# key set while the project is still on legacy HS256.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
